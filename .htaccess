# Halaman awal: arahkan sesuai peran (pegawai -> Isi Harian)
DirectoryIndex beranda.php index.php

# Jangan sajikan file dokumentasi, contoh konfigurasi, cap rilis, atau skrip SQL lewat web
<FilesMatch "\.(md|sql|ini|log|bak|zip)$|\.contoh$|^rilis\.txt$|^\.git">
  Require all denied
</FilesMatch>

# Folder .git (bila memakai deploy Git di hosting) tidak boleh terbaca dari web
RedirectMatch 404 /\.git(/|$)

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Service worker selalu diambil versi terbaru
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  Header always set Referrer-Policy "same-origin"
</IfModule>
