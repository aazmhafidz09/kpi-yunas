return [
    'db_host' => 'localhost',
    'db_name' => 'ISI_NAMA_DATABASE',      // mis. u123456789_kpi
    'db_user' => 'ISI_USER_DATABASE',      // mis. u123456789_kpi
    'db_pass' => 'ISI_PASSWORD_DATABASE',  // password yang Anda buat di hPanel → Database
